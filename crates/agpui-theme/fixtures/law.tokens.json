  "texture": {
    "$description": "Paper Shaders parameters. Vanilla @paper-design/shaders (pinned) on web; WGSL port under PaintBody is the durable path. Texture on the field, never on raised cards.",
    "grain": {
      "$description": "Paper Shaders `paperTexture` (pinned @paper-design/shaders 0.0.77) \u2014 the library's purpose-built static paper-surface shader, not `grainGradient`. Calibrated against zed.dev, whose grain is a 256px noise tile at opacity 0.03 with on-page luminance sigma 2.88; these values reproduce that sigma. Texture on the field, never on raised cards.",
      "colorBack": {
        "$value": "{surface.page}"
      },
      "colorFront": {
        "$value": "{color.cream.400}"
      },
      "opacity": {
        "$value": "0.05",
        "$description": "Static page-field opacity fixed by SPEC-THEOREM-STYLING-API-1.0."
      },
      "opacity.sidebar": {
        "$value": "0.07",
        "$description": "Heavier sidebar field opacity fixed by SPEC-THEOREM-STYLING-API-1.0."
      },
      "scale": {
        "$value": "0.8"
      },
      "speed": {
        "$value": "0",
        "$description": "Static in product chrome. speed 0 stops the rAF loop outright, so the field costs nothing after first paint. Animated grain is hero-only."
      },
      "contrast": {
        "$value": "1",
        "$description": "Sharpest colour transition. Together with roughness this supplies nearly all the field variance."
      },
      "roughness": {
        "$value": "1",
        "$description": "Per-pixel noise, tied to canvas rather than scale \u2014 this is the grain itself."
      },
      "fiber": {
        "$value": "0",
        "$description": "Curly macro-noise. This is what made the field read as cloud rather than tooth; roughness alone carries the grain."
      },
      "fiberSize": {
        "$value": "0.2"
      },
      "crumples": {
        "$value": "0",
        "$description": "No macro structure: an ambient field must not compete with content."
      },
      "crumpleSize": {
        "$value": "0.35"
      },
      "folds": {
        "$value": "0",
        "$description": "See crumples."
      },
      "foldCount": {
        "$value": "1"
      },
      "fade": {
        "$value": "0"
      },
      "drops": {
        "$value": "0",
        "$description": "Measured to have no effect on this field at roughness 1; left off rather than carried as a dead knob."
      },
      "seed": {
        "$value": "5.8"
      }
    },
