@@ -315,7 +362,13 @@ impl Settings {
                 .header(header())
                 .child(
                     SidebarMenu::new().children(pages.iter().map(|(page_ix, page)| {
-                        Self::sidebar_menu_item(state, selected_index, *page_ix, page)
