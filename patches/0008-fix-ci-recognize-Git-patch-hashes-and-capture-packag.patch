From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Travis Gilbert <1travisgilbert@gmail.com>
Date: Sat, 5 Sep 2026 05:10:49 -0400
Subject: [PATCH 08/18] fix(ci): recognize Git patch hashes and capture package
 names

---
 _typos.toml | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/_typos.toml b/_typos.toml
index 61c1bde9..acadc026 100644
--- a/_typos.toml
+++ b/_typos.toml
@@ -1,5 +1,11 @@
 [default]
-extend-ignore-re = ['\\u\{[0-9A-Fa-f]+\}']
+extend-ignore-re = [
+    '\\u\{[0-9A-Fa-f]+\}',
+    # Ordered Git patch object IDs are immutable hex, not prose.
+    '(?m)^index [0-9a-f]+\.\.[0-9a-f]+(?: [0-7]+)?$',
+    # The exact screen-capture package identifier in the dependency patches.
+    '\bzed-scap\b',
+]
 
 [default.extend-words]
 # Official Lucide icon name for the astroid curve.
