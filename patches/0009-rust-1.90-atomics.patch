From 0c6127d7d487e87d679a94625e4ef8d97ad8f2f1 Mon Sep 17 00:00:00 2001
From: Travis Gilbert <1travisgilbert@gmail.com>
Date: Thu, 3 Sep 2026 22:43:50 -0400
Subject: [PATCH] fix(base): support Rust 1.90 atomics

---
 crates/base/src/text_selection.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/crates/base/src/text_selection.rs b/crates/base/src/text_selection.rs
index b294805b..5e9233f8 100644
--- a/crates/base/src/text_selection.rs
+++ b/crates/base/src/text_selection.rs
@@ -28,7 +28,7 @@ impl TextSelectionScopeId {
     pub fn new() -> Self {
         static NEXT_SCOPE_ID: AtomicU64 = AtomicU64::new(1);
         let value = NEXT_SCOPE_ID
-            .try_update(Ordering::Relaxed, Ordering::Relaxed, |value| {
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |value| {
                 value.checked_add(1)
             })
             .expect("text selection scope identifiers exhausted");

