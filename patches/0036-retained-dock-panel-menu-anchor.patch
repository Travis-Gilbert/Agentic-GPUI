+/// The exact menu used by the native toolbar and its platform-owned trigger.
+/// Keeping the same Popover preserves menu creation, focus and dismissal.
+pub(crate) fn panel_menu_button(
+    group: &TabGroupContext,
+    hidden_trigger: bool,
+    presenter: Option<Rc<dyn Fn() -> PopupMenuPresenter>>,
+    ready: impl Fn(gpui::WeakEntity<crate::popover::PopoverState>, &mut Window, &mut App) + 'static,
+) -> impl IntoElement {
+    let group = group.clone();
+    Button::new("menu")
+        .icon(IconName::Ellipsis)
+        .xsmall()
+        .ghost()
+        .accessibility_label(t!("Dock.PanelMenu"))
+        .tab_stop(false)
+        .when(hidden_trigger, |button| button.invisible())
+        .dropdown_menu(move |menu, window, cx| {
+            populate_panel_menu(menu, &group, window, cx)
+                .when_some(presenter.as_ref(), |menu, factory| {
+                    menu.presenter(factory())
+                })
+        })
+        .anchor(Anchor::TopRight)
+        .on_state_ready(ready)
+}
+
+fn populate_panel_menu(
+    menu: PopupMenu,
+    group: &TabGroupContext,
+    window: &mut Window,
+    cx: &mut Context<PopupMenu>,
+) -> PopupMenu {
+    let zoomed = group.is_zoomed();
+    let menu_zoom = zoom_control(group, cx).is_some_and(|control| control.menu_visible());
+    let closable = group.is_closable();
+    let panel = group
+        .active_panel()
+        .and_then(PanelHandle::of)
+        .map(|handle| handle.panel());
+    menu.when_some(panel, |menu, panel| panel.dropdown_menu(menu, window, cx))
+        .separator()
+        .menu_with_disabled(
+            if zoomed {
+                t!("Dock.Zoom Out")
+            } else {
+                t!("Dock.Zoom In")
+            },
+            Box::new(ToggleZoom),
+            !menu_zoom,
+        )
+        .when(closable, |menu| {
+            menu.separator()
+                .menu(t!("Dock.Close"), Box::new(ClosePanel))
+        })
+}
