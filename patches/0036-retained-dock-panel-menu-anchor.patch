+    struct PlatformMenuRenderer {
+        skin: Rc<DockSkin>,
+        state: Rc<RefCell<Option<gpui::WeakEntity<crate::popover::PopoverState>>>>,
+        menu: Rc<RefCell<Option<crate::menu::PopupMenuPresentation>>>,
+    }
+    impl DockAreaRenderer for PlatformMenuRenderer {
+        fn frame(&self, window: &mut Window, cx: &mut App) -> Stateful<Div> {
+            self.skin.frame(window, cx)
+        }
+        fn tab_group_renderer(&self) -> Rc<dyn TabGroupRenderer> {
+            Rc::new(Self {
+                skin: self.skin.clone(),
+                state: self.state.clone(),
+                menu: self.menu.clone(),
+            })
+        }
+    }
+    impl TabGroupRenderer for PlatformMenuRenderer {
+        fn frame(
+            &self,
+            group: &TabGroupContext,
+            window: &mut Window,
+            cx: &mut App,
+        ) -> Stateful<Div> {
+            TabGroupSkin::new(self.skin.shared().clone()).frame(group, window, cx)
+        }
+        fn render_tab_bar(
+            &self,
+            group: &TabGroupContext,
+            _: &mut Window,
+            _: &mut App,
+        ) -> AnyElement {
+            let state = self.state.clone();
+            let observed = self.menu.clone();
+            let factory: Rc<dyn Fn() -> PopupMenuPresenter> = Rc::new(move || {
+                let observed = observed.clone();
+                PopupMenuPresenter::new(
+                    move |menu, _, _| {
+                        *observed.borrow_mut() = Some(menu);
+                        true
+                    },
+                    |_| {},
+                )
+            });
+            div()
+                .h(px(30.))
+                .child(
+                    self.skin
+                        .tab_menu_anchor(group, Some(factory), move |owner, _, _| {
+                            *state.borrow_mut() = Some(owner);
+                        }),
+                )
+                .into_any_element()
+        }
+    }
+
+    /// The platform trigger calls the actual retained Popover, and its menu
+    /// invokes the existing tab-group action handlers rather than copied ops.
+    #[gpui::test]
+    fn a_platform_panel_menu_uses_the_native_owner_and_close_action(cx: &mut TestAppContext) {
+        use crate::menu::PopupMenuInput;
+        cx.update(crate::init);
+        let observed = Rc::new(RefCell::new(None));
+        let menu = Rc::new(RefCell::new(None));
+        let (area, cx) = cx.add_window_view({
+            let state = observed.clone();
+            let menu = menu.clone();
+            move |window, cx| {
+                let skin = DockSkin::new(cx);
+                DockArea::new("platform-menu", None, window, cx)
+                    .with_renderer(Rc::new(PlatformMenuRenderer { skin, state, menu }))
+            }
+        });
+        let (first, second) = cx.update(|window, cx| {
+            let first = Probe::new(cx);
+            let second = Probe::new(cx);
+            let layout = DockLayout::tabs()
+                .panel_view(panel_handle(first.clone()), cx)
+                .panel_view(panel_handle(second.clone()), cx);
+            area.update(cx, |area, cx| area.set_center(layout, window, cx));
+            (first, second)
+        });
+        cx.run_until_parked();
+        cx.update(|window, cx| window.draw(cx).clear(cx));
+        let controller = observed.borrow().clone().expect("actual keyed anchor");
+        let open = |cx: &mut VisualTestContext| {
+            cx.update(|window, cx| {
+                let focus = first.read(cx).focus_handle.clone();
+                window.focus(&focus, cx);
+                controller
+                    .update(cx, |owner, cx| owner.show(window, cx))
+                    .unwrap();
+                window.refresh();
+                for _ in 0..3 {
+                    window.draw(cx).clear(cx);
+                }
+            });
+            cx.run_until_parked();
+            cx.update(|window, cx| window.draw(cx).clear(cx));
+        };
+        open(cx);
+        let first_menu_id = menu
+            .borrow()
+            .as_ref()
+            .expect("actual menu allocation")
+            .entity()
+            .entity_id();
+        {
+            let snapshot = menu.borrow();
+            let snapshot = snapshot.as_ref().unwrap();
+            assert!(
+                snapshot.bounds().size.width > px(0.) && snapshot.bounds().size.height > px(0.)
+            );
+            assert!(
+                snapshot.is_platform_delegated(),
+                "existing menu acknowledges its actual presenter"
+            );
+            assert!(
+                snapshot
+                    .rows()
+                    .iter()
+                    .any(|row| row.label().as_ref() == "Zoom In")
+            );
+            assert!(
+                snapshot
+                    .rows()
+                    .iter()
+                    .any(|row| row.label().as_ref() == "Close")
+            );
+        }
+        cx.simulate_keystrokes("escape");
+        cx.run_until_parked();
+        cx.update(|window, cx| {
+            window.draw(cx).clear(cx);
+            assert!(!controller.upgrade().unwrap().read(cx).is_open());
+        });
+        open(cx);
+        let snapshot = menu.borrow().clone().unwrap();
+        assert_ne!(
+            snapshot.entity().entity_id(),
+            first_menu_id,
+            "reopening builds a fresh actual owner"
+        );
+        let close = snapshot
+            .rows()
+            .iter()
+            .find(|row| row.label().as_ref() == "Close")
+            .unwrap()
+            .index();
+        cx.update(|window, cx| {
+            snapshot
+                .entity()
+                .update(cx, |menu, cx| {
+                    menu.presented_input(
+                        snapshot.revision(),
+                        PopupMenuInput::Activate(close),
+                        window,
+                        cx,
+                    )
+                })
+                .unwrap()
+                .unwrap()
+        });
+        cx.run_until_parked();
+        cx.update(|_, cx| {
+            assert!(
+                area.read(cx)
+                    .panel(PanelId::from(first.entity_id()))
+                    .is_none(),
+                "existing ClosePanel action removes the active panel"
+            );
+            assert!(
+                area.read(cx)
+                    .panel(PanelId::from(second.entity_id()))
+                    .is_some(),
+                "other retained panel survives"
+            );
+        });
+    }
+
     /// The gate carried forward from the old `TabPanel::render`, which wrapped
     /// `on_drag` in `.when(state.draggable, ..)`. Base does not enforce it:
     /// `TabGroupContext::drag_panel` answers for any tab in range.
