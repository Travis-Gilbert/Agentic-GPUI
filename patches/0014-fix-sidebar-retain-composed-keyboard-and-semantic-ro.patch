From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Travis Gilbert <1travisgilbert@gmail.com>
Date: Sat, 5 Sep 2026 10:14:24 -0400
Subject: [PATCH 14/18] fix(sidebar): retain composed keyboard and semantic row
 bindings

---
 crates/component/src/sidebar/menu.rs | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/crates/component/src/sidebar/menu.rs b/crates/component/src/sidebar/menu.rs
index 6abf5847..a521c5e9 100644
--- a/crates/component/src/sidebar/menu.rs
+++ b/crates/component/src/sidebar/menu.rs
@@ -222,14 +222,21 @@ impl SidebarMenuItem {
 
     /// Decorate the actual clickable row, excluding its expanded submenu.
     ///
-    /// The existing click, open, hover and tooltip behavior is retained. This
-    /// hook supports accessibility and measured-row adapters without adding a
-    /// second interactive wrapper. It runs before the optional context menu.
+    /// The existing click, open, hover and tooltip behavior is retained.
+    /// Repeated hooks compose in call order, supporting accessibility and
+    /// measured-row adapters without a second interactive wrapper. They run
+    /// before the optional context menu.
     pub fn item_with(
         mut self,
         decorate: impl Fn(Stateful<Div>) -> Stateful<Div> + 'static,
     ) -> Self {
-        self.item_with = Some(Rc::new(decorate));
+        let previous = self.item_with.take();
+        self.item_with = Some(Rc::new(move |row| {
+            decorate(match &previous {
+                Some(previous) => previous(row),
+                None => row,
+            })
+        }));
         self
     }
 
