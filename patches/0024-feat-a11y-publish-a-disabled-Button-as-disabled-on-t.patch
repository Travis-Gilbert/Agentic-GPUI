diff --git a/crates/base/src/button.rs b/crates/base/src/button.rs
index dbc503d6..64644e52 100644
--- a/crates/base/src/button.rs
+++ b/crates/base/src/button.rs
@@ -246,6 +246,9 @@ impl RenderOnce for Button {
             .when_some(self.accessibility_description, |this, description| {
                 this.aria_description(description)
             })
+            // The platform reads the same state the pointer does: an inert
+            // button is announced as unavailable, not just drawn dim.
+            .aria_disabled(disabled)
             .when(!disabled && self.focusable, |this| {
                 this.track_focus(
                     &focus_handle
@@ -562,9 +565,7 @@ mod tests {
         assert_eq!(disabled.role(), Role::Button);
         assert!(!disabled.supports_action(accesskit::Action::Click));
 
-        // GPUI's current StatefulInteractiveElement interface has no
-        // aria-disabled setter even though AccessKit can represent it. This
-        // assertion records that upstream gap instead of claiming support.
-        assert!(!disabled.is_disabled());
+        assert!(disabled.is_disabled());
+        assert!(!enabled.is_disabled());
     }
 }
diff --git a/crates/kit/tests/components.rs b/crates/kit/tests/components.rs
index 0ef8deb1..b83c67a1 100644
--- a/crates/kit/tests/components.rs
+++ b/crates/kit/tests/components.rs
@@ -59,7 +59,7 @@ fn kit_controls_use_native_events_and_report_state(cx: &mut TestAppContext) {
         });
     cx.update_window(handle.into(), |_, window, cx| {
         window.draw(cx).clear(cx);
-        assert_eq!(window.find("disabled").disabled(), None);
+        assert_eq!(window.find("disabled").disabled(), Some(true));
         window.click("disabled", cx);
         window.click("search", cx);
         assert_eq!(window.find("search").focused(), Some(true));
