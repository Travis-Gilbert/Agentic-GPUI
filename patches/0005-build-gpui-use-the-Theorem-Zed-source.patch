From 22b4c699f08e363e11ff76f5b645994b614bebd4 Mon Sep 17 00:00:00 2001
From: Travis Gilbert <1travisgilbert@gmail.com>
Date: Thu, 3 Sep 2026 21:53:46 -0400
Subject: [PATCH 05/22] build(gpui): use the Theorem Zed source

---
 Cargo.toml                                | 37 ++++++++++++-----------
 crates/component-macros/src/crate_path.rs |  4 +--
 crates/fps/README.md                      |  9 +++---
 crates/kit/src/lib.rs                     |  4 +--
 4 files changed, 27 insertions(+), 27 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 142d0d42..10810ed5 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -60,26 +60,22 @@ gpui-webview = { path = "crates/webview", version = "0.7.1" }
 gpui-component-shell = { path = "crates/component-shell", version = "0.7.1" }
 story = { path = "crates/story" }
 
-# GPUI comes from the `gpui-pre-*` snapshots of Zed's crates, and any snapshot
-# may change GPUI's API. These requirements are what the published gpui-kit
-# crates carry to crates.io, so they pin the exact snapshot the release was
-# built against: a caret requirement let the weekly release move applications
-# onto a newer snapshot that gpui-component did not compile with (#3156). Bump
-# every snapshot crate together with its Cargo.lock entry; `script/check-gpui-pin.ts`
-# fails CI when a pin is not exact.
-gpui = { package = "gpui-pre", version = "=0.3.9" }
-gpui_platform = { package = "gpui-pre-platform", version = "=0.3.9", features = ["font-kit", "x11", "wayland", "runtime_shaders"] }
-gpui_web = { package = "gpui-pre-web", version = "=0.3.9" }
+# GPUI comes from Theorem's pinned Zed fork rather than upstream's `gpui-pre-*`
+# snapshots, so every GPUI family crate resolves from one immutable revision and
+# Theorem keeps a single GPUI type identity.
+gpui = { git = "https://github.com/Travis-Gilbert/zed", rev = "6d4d90754f7dde3e62afb6fe74a632c0b4660396" }
+gpui_platform = { git = "https://github.com/Travis-Gilbert/zed", rev = "6d4d90754f7dde3e62afb6fe74a632c0b4660396", features = ["font-kit", "x11", "wayland", "runtime_shaders"] }
+gpui_web = { git = "https://github.com/Travis-Gilbert/zed", rev = "6d4d90754f7dde3e62afb6fe74a632c0b4660396" }
 # Fast is optional; existing crates select it through their gpui-fast feature.
 # Explicit package fields make Cargo use these dependency keys as Rust crate names;
 # the packages declare the same library names as the pre backend.
 gpui-fast = { package = "gpui-fast", version = "0.1.7", features = ["windows-manifest-provided-by-host"] }
 gpui-fast-platform = { package = "gpui-fast-platform", version = "0.1.7", features = ["font-kit", "x11", "wayland", "runtime_shaders"] }
 gpui-fast-web = { package = "gpui-fast-web", version = "0.1.7" }
-gpui_macros = { package = "gpui-pre-macros", version = "=0.3.9" }
-reqwest_client = { package = "gpui-pre-reqwest-client", version = "=0.3.9" }
-sum-tree = { package = "gpui-pre-sum-tree", version = "=0.3.9" }
-reqwest = { package = "gpui-pre-reqwest", version = "=0.12.15", default-features = false, features = [
+gpui_macros = { git = "https://github.com/Travis-Gilbert/zed", rev = "6d4d90754f7dde3e62afb6fe74a632c0b4660396" }
+reqwest_client = { git = "https://github.com/Travis-Gilbert/zed", rev = "6d4d90754f7dde3e62afb6fe74a632c0b4660396" }
+sum-tree = { package = "sum_tree", git = "https://github.com/Travis-Gilbert/zed", rev = "6d4d90754f7dde3e62afb6fe74a632c0b4660396" }
+reqwest = { package = "zed-reqwest", git = "https://github.com/zed-industries/reqwest.git", rev = "33bc764aa15ff7b200bf7c93bd96e24878d53e14", version = "0.12.15-zed", default-features = false, features = [
     "charset",
     "http2",
     "macos-system-configuration",
@@ -159,15 +155,15 @@ rustybuzz = { opt-level = 3 }
 taffy = { opt-level = 3 }
 ttf-parser = { opt-level = 3 }
 smol = { opt-level = 3 }
-gpui-pre = { opt-level = 3 }
+gpui = { opt-level = 3 }
 gpui-fast = { opt-level = 3 }
 gpui-fast-platform = { opt-level = 3 }
-gpui-pre-platform = { opt-level = 3 }
+gpui_platform = { opt-level = 3 }
 tree-sitter = { opt-level = 3 }
-gpui-pre-sum-tree = { opt-level = 3 }
+sum_tree = { opt-level = 3 }
 ropey = { opt-level = 3 }
 lsp-types = { opt-level = 3 }
-gpui-pre-reqwest-client = { opt-level = 3 }
+reqwest_client = { opt-level = 3 }
 markdown = { opt-level = 3 }
 xml5ever = { opt-level = 3 }
 # `quickjs-jit` is a facade that re-exports `quickjs-jit-core`, so naming it alone
@@ -195,3 +191,8 @@ consts = "consts"
 
 [workspace.metadata.cargo-machete]
 ignored = ["log", "anyhow", "serde"]
+
+[workspace.metadata.theorem-fork]
+upstream = "https://github.com/longbridge/gpui-kit"
+upstream_tag = "v0.6.0"
+zed_rev = "6d4d90754f7dde3e62afb6fe74a632c0b4660396"
diff --git a/crates/component-macros/src/crate_path.rs b/crates/component-macros/src/crate_path.rs
index 778dbdb5..ff86c91d 100644
--- a/crates/component-macros/src/crate_path.rs
+++ b/crates/component-macros/src/crate_path.rs
@@ -4,14 +4,14 @@ use quote::quote;
 
 /// Resolve the consumer's GPUI API, preferring the Kit facade over a direct engine.
 pub(crate) fn gpui() -> syn::Result<TokenStream> {
-    for package in ["gpui-kit", "gpui-pre", "gpui-fast"] {
+    for package in ["gpui-kit", "gpui", "gpui-fast"] {
         if let Ok(found) = crate_name(package) {
             return Ok(found_crate_path(found));
         }
     }
     Err(syn::Error::new(
         Span::call_site(),
-        "IntoPlot requires a direct dependency on gpui-kit, gpui-pre, or gpui-fast",
+        "IntoPlot requires a direct dependency on gpui-kit, gpui, or gpui-fast",
     ))
 }
 
diff --git a/crates/fps/README.md b/crates/fps/README.md
index 0cb942ea..192f23e7 100644
--- a/crates/fps/README.md
+++ b/crates/fps/README.md
@@ -41,11 +41,10 @@ It does not depend on `gpui-component`, so it works in any GPUI application.
 gpui-fps = { git = "https://github.com/longbridge/gpui-kit" }
 ```
 
-It must resolve to the same `gpui` as your application. Both depending on the
-same `gpui-pre` version is enough — Cargo unifies them — but a `[patch]`, a
-different `gpui-pre` version, or a checkout of the Zed repository will produce
-two incompatible `gpui` crates, and the error will be about mismatched `Window`
-types rather than about versions.
+It must resolve to the same `gpui` as your application. This fork pins the GPUI
+family to one immutable revision of Theorem's Zed fork. A different Zed
+revision produces two incompatible `gpui` crates, and the error will be about
+mismatched `Window` types rather than about versions.
 
 ### 2. Render it
 
diff --git a/crates/kit/src/lib.rs b/crates/kit/src/lib.rs
index 3595631b..ec603405 100644
--- a/crates/kit/src/lib.rs
+++ b/crates/kit/src/lib.rs
@@ -1,7 +1,7 @@
 //! GPUI Kit: one dependency for building desktop applications with GPUI.
 //!
-//! GPUI itself is published as a family of `gpui-pre-*` crates that move
-//! together. This crate depends on the matching set for you, so an
+//! GPUI is consumed from Theorem's pinned Zed fork as a family of crates that
+//! move together. This crate depends on the matching set for you, so an
 //! application lists `gpui-kit` alone. `use gpui_kit::*;` is GPUI, and each
 //! layer is reachable by name:
 //!
-- 
2.53.0

