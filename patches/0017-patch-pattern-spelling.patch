From bd326291bb967274acd50cd6ece9935b93172463 Mon Sep 17 00:00:00 2001
From: Travis Gilbert <1travisgilbert@gmail.com>
Date: Sat, 5 Sep 2026 05:23:00 -0400
Subject: [PATCH] fix(ci): recognize the capture name inside its own patch
 pattern

---
 _typos.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/_typos.toml b/_typos.toml
index e9abe518..78a0e762 100644
--- a/_typos.toml
+++ b/_typos.toml
@@ -4,7 +4,7 @@ extend-ignore-re = [
     # Ordered Git patch object IDs are immutable hex, not prose.
     '(?m)^index [0-9a-f]+\.\.[0-9a-f]+(?: [0-7]+)?$',
     # The exact screen-capture package identifier in the dependency patches.
-    '\bzed-scap\b',
+    'zed-scap',
 ]
 
 [default.extend-words]
-- 
