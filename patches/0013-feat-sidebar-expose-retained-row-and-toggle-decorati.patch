 decoration hooks

---
 crates/component/src/sidebar/menu.rs | 24 ++++++++++++++++++++++--
 crates/component/src/sidebar/mod.rs  | 13 +++++++++++++
 2 files changed, 35 insertions(+), 2 deletions(-)

diff --git a/crates/component/src/sidebar/menu.rs b/crates/component/src/sidebar/menu.rs
index fe26ed96..6abf5847 100644
--- a/crates/component/src/sidebar/menu.rs
