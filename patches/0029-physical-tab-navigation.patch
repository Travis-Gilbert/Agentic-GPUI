From 80e55675a608db2d9c5ced3fb37d4d5a3bf015c1 Mon Sep 17 00:00:00 2001
From: Travis Gilbert <1travisgilbert@gmail.com>
Date: Thu, 15 Oct 2026 13:26:30 -0400
Subject: [PATCH] feat(input): opt browser composers into physical Tab
 navigation

---
 crates/base/src/input/base/state.rs | 48 ++++++++++++++++--
 crates/component/src/input/state.rs | 76 +++++++++++++++++++++++++++++
 2 files changed, 121 insertions(+), 3 deletions(-)

diff --git a/crates/base/src/input/base/state.rs b/crates/base/src/input/base/state.rs
index 943e115d..030a7ea5 100644
--- a/crates/base/src/input/base/state.rs
+++ b/crates/base/src/input/base/state.rs
@@ -85,6 +85,8 @@ actions!(
         Outdent,
         IndentInline,
         OutdentInline,
+        TabNext,
+        TabPrevious,
         MoveUp,
         MoveDown,
         MoveLeft,
@@ -193,8 +195,10 @@ pub(crate) fn init(cx: &mut App) {
         KeyBinding::new("right", MoveRight, Some(CONTEXT)),
         KeyBinding::new("pageup", MovePageUp, Some(CONTEXT)),
         KeyBinding::new("pagedown", MovePageDown, Some(CONTEXT)),
-        KeyBinding::new("tab", IndentInline, Some(CONTEXT)),
-        KeyBinding::new("shift-tab", OutdentInline, Some(CONTEXT)),
+        KeyBinding::new("tab", IndentInline, Some("Input && !TabNavigation")),
+        KeyBinding::new("tab", TabNext, Some("Input && TabNavigation")),
+        KeyBinding::new("shift-tab", OutdentInline, Some("Input && !TabNavigation")),
+        KeyBinding::new("shift-tab", TabPrevious, Some("Input && TabNavigation")),
         KeyBinding::new("shift-left", SelectLeft, Some(CONTEXT)),
         KeyBinding::new("shift-right", SelectRight, Some(CONTEXT)),
         KeyBinding::new("shift-up", SelectUp, Some(CONTEXT)),
@@ -415,6 +419,7 @@ pub struct InputBaseState<M: InputModeKind> {
     pub(super) searchable: bool,
     pub(super) replaceable: bool,
     pub(super) soft_wrap: bool,
+    tab_navigation: bool,
     pub(super) wrapping_indent: WrappingIndent,
     pub(super) scroll_beyond_last_line: Option<usize>,
     pub(super) cursor_surrounding_lines: Option<usize>,
@@ -791,6 +796,7 @@ impl<M: InputModeKind> InputBaseState<M> {
             searchable: false,
             replaceable: true,
             soft_wrap: true,
+            tab_navigation: false,
             wrapping_indent: WrappingIndent::default(),
             scroll_beyond_last_line: None,
             cursor_surrounding_lines: None,
@@ -882,6 +888,21 @@ impl<M: InputModeKind> InputBaseState<M> {
         self
     }
 
+    /// Let physical Tab and Shift-Tab move focus rather than indent.
+    /// Explicit indentation actions keep their existing meaning.
+    pub fn tab_navigation(mut self, enabled: bool) -> Self {
+        self.tab_navigation = enabled;
+        self
+    }
+
+    /// Change whether physical Tab navigates focus.
+    pub fn set_tab_navigation(&mut self, enabled: bool, cx: &mut Context<Self>) {
+        if self.tab_navigation != enabled {
+            self.tab_navigation = enabled;
+            cx.notify();
+        }
+    }
+
     /// Set placeholder
     pub fn placeholder(mut self, placeholder: impl Into<SharedString>) -> Self {
         self.placeholder = placeholder.into();
@@ -4716,7 +4737,11 @@ impl<M: InputModeKind> Render for InputBaseState<M> {
 
         let element = div()
             .id("input-state")
-            .key_context(CONTEXT)
+            .key_context(if self.tab_navigation {
+                "Input TabNavigation"
+            } else {
+                CONTEXT
+            })
             .track_focus(&self.focus_handle)
             .when(self.is_editable(), |this| {
                 this.on_action(window.listener_for(&entity, InputBaseState::backspace))
@@ -4740,6 +4765,23 @@ impl<M: InputModeKind> Render for InputBaseState<M> {
                             .on_action(window.listener_for(&entity, InputBaseState::outdent_block))
                     })
             })
+            .when(self.tab_navigation, |this| {
+                this.on_action(
+                    window.listener_for(&entity, |state, _: &TabNext, window, cx| {
+                        if state.ime_marked_range.is_none() {
+                            window.focus_next(cx);
+                        }
+                    }),
+                )
+                .on_action(window.listener_for(
+                    &entity,
+                    |state, _: &TabPrevious, window, cx| {
+                        if state.ime_marked_range.is_none() {
+                            window.focus_prev(cx);
+                        }
+                    },
+                ))
+            })
             .on_action(window.listener_for(&entity, InputBaseState::left))
             .on_action(window.listener_for(&entity, InputBaseState::right))
             .on_action(window.listener_for(&entity, InputBaseState::select_left))
diff --git a/crates/component/src/input/state.rs b/crates/component/src/input/state.rs
index 0ba20439..9eb37187 100644
--- a/crates/component/src/input/state.rs
+++ b/crates/component/src/input/state.rs
@@ -389,3 +389,79 @@ pub(super) fn sync_focused_input_registry(
         cx.notify();
     });
 }
+
+#[cfg(test)]
+mod tab_navigation_tests {
+    use super::*;
+    use gpui::{
+        AppContext, Context, InteractiveElement, IntoElement, ParentElement, Render, Styled,
+        TestAppContext, div,
+    };
+
+    struct Host {
+        editor: Entity<EditorState>,
+        next: FocusHandle,
+    }
+    impl Render for Host {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            div()
+                .size_full()
+                .flex()
+                .flex_row()
+                .child(
+                    div()
+                        .w(gpui::px(200.))
+                        .h(gpui::px(100.))
+                        .child(self.editor.clone()),
+                )
+                .child(div().id("next").track_focus(&self.next).size_8())
+        }
+    }
+
+    #[gpui::test]
+    fn physical_tab_navigation_preserves_explicit_indent_actions(cx: &mut TestAppContext) {
+        cx.update(|cx| {
+            crate::init(cx);
+            cx.set_global(crate::Theme::default());
+        });
+        let (host, cx) = cx.add_window_view(|window, cx| Host {
+            editor: cx.new(|cx| EditorState::new(window, cx).tab_navigation(true)),
+            next: cx.focus_handle().tab_stop(true),
+        });
+        let editor = host.read_with(cx, |host, _| host.editor.clone());
+        cx.update(|window, cx| {
+            editor.update(cx, |state, cx| {
+                state.focus(window, cx);
+                state.set_value("word", window, cx);
+                state.set_selected_range(4..4, cx);
+            });
+            window.draw(cx).clear(cx);
+        });
+        cx.simulate_keystrokes("tab");
+        cx.update(|window, cx| {
+            assert!(host.read(cx).next.is_focused(window));
+            assert_eq!(editor.read(cx).value().as_ref(), "word");
+        });
+        cx.update(|window, cx| window.focus_prev(cx));
+        // Native traversal wraps from the first item. The opt-in reverse
+        // binding must reach that same coordinator rather than outdent.
+        cx.simulate_keystrokes("shift-tab");
+        cx.update(|window, cx| {
+            assert!(host.read(cx).next.is_focused(window));
+            window.focus_prev(cx);
+            assert!(editor.read(cx).focus_handle(cx).is_focused(window));
+            window.dispatch_action(Box::new(super::super::IndentInline), cx);
+        });
+        cx.update(|window, cx| {
+            assert_eq!(editor.read(cx).value().as_ref(), "word  ");
+            editor.update(cx, |state, cx| {
+                state.set_value("word", window, cx);
+                state.set_selected_range(4..4, cx);
+                state.set_tab_navigation(false, cx);
+            });
+            window.draw(cx).clear(cx);
+        });
+        cx.simulate_keystrokes("tab");
+        cx.update(|_, cx| assert_eq!(editor.read(cx).value().as_ref(), "word  "));
+    }
+}
